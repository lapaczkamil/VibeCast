# Mirrors app/config.py Settings. Values here are the code defaults;
# secrets are intentionally blank.

# --- App
APP_NAME=VibeCast
FRONTEND_URL=http://127.0.0.1:5173

# --- Spotify OAuth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# --- External APIs
TMDB_API_KEY=
OPENAI_API_KEY=
RECCOBEATS_BASE_URL=https://api.reccobeats.com
RECCOBEATS_TIMEOUT_SECONDS=4.0

# --- Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# --- RAG index
RAG_COLLECTION=movies
RAG_CHROMA_PATH=data/chroma

# --- Sessions
SESSION_DB_PATH=data/app.db
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=vibecast_session
SESSION_COOKIE_SECURE=false
RAG_MOVIE_TARGET=10000
RAG_MIN_RATING=7.0
RAG_DISCOVER_SHARE=0.6
RAG_DISCOVER_VOTE_COUNT_GTE=500
RAG_ENRICH_DOCUMENTS=true
RAG_ENRICH_WORKERS=8
RAG_EMBED_TITLE=false

# --- Retrieval
RAG_HYDE_ENABLED=true
RAG_HYBRID_ENABLED=false
RAG_HYBRID_CANDIDATES=32
RAG_RRF_K=60

# --- Lyrics (LRCLIB)
LYRICS_ENABLED=true
LRCLIB_BASE_URL=https://lrclib.net
LYRICS_MAX_CHARS=1200
LYRICS_TIMEOUT_SECONDS=4.0
